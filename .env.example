# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (9router or Anthropic). Fill with whatever gateway you use.
AI_API_KEY=sk-ant-xxxx
AI_BASE_URL=
AI_MODEL=claude-sonnet-5

# Base URL used to build shareable invoice + referral links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PayPal (enables the "Pay with PayPal" button on invoices).
# Create an app at developer.paypal.com → Apps & Credentials → Sandbox.
# PAYPAL_WEBHOOK_ID comes from the webhook you add there; it is what the
# signature check is verified against, so the endpoint is closed without it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Solana / USDC (opsional — kalau kosong, opsi bayar USDC tidak ditampilkan)
# Pakai RPC berbayar (Helius / Alchemy). RPC publik api.devnet.solana.com
# kena rate limit dan akan membuat verifikasi gagal secara acak, yang di layar
# terlihat seperti pembayaran bermasalah padahal bukan.
SOLANA_NETWORK=solana-devnet
SOLANA_RPC_URL=
SOLANA_USDC_MINT=
# Hanya untuk Arah B (bayar langganan ke Involoop). Kalau kosong atau bukan
# alamat sah, opsi USDC untuk paket dimatikan — lebih baik daripada menerima
# uang di alamat yang tidak dikuasai siapa pun.
SOLANA_PLATFORM_WALLET=
SOLANA_WEBHOOK_SECRET=
NEXT_PUBLIC_SOLANA_NETWORK=solana-devnet
